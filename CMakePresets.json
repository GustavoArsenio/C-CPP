{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Portable learning examples",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "sanitized",
      "displayName": "Examples with address and undefined sanitizers",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/sanitized",
      "cacheVariables": {
        "LEARNING_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "default", "configurePreset": "default"},
    {"name": "sanitized", "configurePreset": "sanitized"}
  ],
  "testPresets": [
    {"name": "default", "configurePreset": "default", "output": {"outputOnFailure": true}},
    {"name": "sanitized", "configurePreset": "sanitized", "output": {"outputOnFailure": true}}
  ]
}
